<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/contextual_card_side_margin"
    android:layout_marginTop="@dimen/contextual_card_vertical_margin"
    android:layout_marginEnd="@dimen/contextual_card_side_margin"
    android:layout_marginBottom="@dimen/contextual_card_vertical_margin"
    android:contentDescription="@string/minus_os_logo"
    app:cardBackgroundColor="@color/materialColorSurfaceContainer"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/settingslib_materialColorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="144dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/minus_os_logo_minus"
                    android:textColor="#071A36"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/minus_os_logo_os"
                    android:textColor="#2563EB"
                    android:textSize="48sp" />
            </LinearLayout>

            <View
                android:layout_width="40dp"
                android:layout_height="6dp"
                android:layout_gravity="start"
                android:layout_marginStart="28dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/minus_os_logo_underline" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
